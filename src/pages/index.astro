---
import BaseLayout from '../layouts/BaseLayout.astro';

const recentTracks = [
  {
    title: 'Boarding Soon',
    artist: 'Yoyo Sham',
    album: 'Nothing Is under Control',
  },
  {
    title: 'Spain',
    artist: 'Chick Corea',
    album: 'Light As a Feather',
  },
  {
    title: 'Honour',
    artist: 'KUN',
    album: 'KUN',
  },
  {
    title: 'It Could Happen To You',
    artist: 'RYO FUKUI',
    album: 'Scenery',
  },
  {
    title: 'No Verao, As Noites',
    artist: 'Sheena Ringo',
    album: 'No verao, as noites / God, Nor Buddha - Single',
  },
  {
    title: 'Futari-bocchi Jikan - Just the Two of Us',
    artist: 'Sheena Ringo',
    album: 'Sanmon Gossip',
  },
  {
    title: 'Karisome Otome - "Temporary" Virgin (Death Jazz Version)',
    artist: '椎名林檎×SOIL&"PIMP"SESSIONS',
    album: 'Sanmon Gossip',
  },
  {
    title: 'Kamala\'s Danz (feat. Sreya)',
    artist: 'Okvsho',
    album: 'Kamala\'s Danz',
  },
  {
    title: 'Marunouchi Sadistic',
    artist: 'Sheena Ringo',
    album: 'Muzai Moratorium - Innocence Moratorium',
  },
];
---

<BaseLayout title="Yang Mingtian">
  <h1>Yang Mingtian</h1>
  <p>
    I work across manufacturing, software, and international expansion — building practical
    tools and clearer ways for industrial businesses to communicate with the world.
  </p>
  <p>
    Recently I’ve been helping a manufacturing company move toward precision fluid control
    platforms for extreme conditions, tightening how multi-category industrial products are
    positioned for overseas buyers, and narrowing an M&A target search into a few focused
    tracks.
  </p>
  <p>
    See <a href="/now">what I’m currently focused on</a>.
  </p>

  <section class="current-work" aria-labelledby="current-work-title">
    <p class="eyebrow">Current work</p>
    <h2 id="current-work-title">What I’m paying attention to now</h2>
    <div class="work-grid">
      <article>
        <h3>Precision fluid control</h3>
        <p>
          Pushing a company toward precision fluid control platforms for extreme conditions —
          valves, heating and temperature-sensing components, and the engineering story behind them.
        </p>
      </article>
      <article>
        <h3>Industrial B2B going global</h3>
        <p>
          Positioning valves, mechanical parts, and instruments for overseas buyers — and building
          the hiring case, content, and measurement loop around that expansion.
        </p>
      </article>
      <article>
        <h3>Focused M&A scouting</h3>
        <p>
          Narrowing a target search into core tracks: semiconductor precision heating and
          temperature sensing, industrial electric heating, temperature control instruments, and
          ceramic sealing.
        </p>
      </article>
    </div>
  </section>

  <section class="playlist" aria-labelledby="playlist-title">
    <div class="playlist-header">
      <div>
        <p class="eyebrow">Recently played</p>
        <h2 id="playlist-title">On repeat lately</h2>
      </div>
      <span class="playlist-note">Apple Music · updated Aug 13, 2026</span>
    </div>

    <ol class="track-list">
      {recentTracks.map((track, index) => (
        <li class="track">
          <span class="track-number">{String(index + 1).padStart(2, '0')}</span>
          <span class="track-main">
            <strong>{track.title}</strong>
            <span>{track.artist}</span>
          </span>
          <span class="track-album">{track.album}</span>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .current-work {
    margin-top: 3.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .current-work h2 {
    margin-top: 0;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    margin-top: 1.1rem;
  }

  .work-grid article {
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--rule) 82%, transparent);
    border-radius: 0.85rem;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
  }

  .work-grid h3 {
    margin: 0 0 0.55rem;
    font-size: 1rem;
  }

  .work-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 0.94rem;
  }

  .playlist {
    margin-top: 3.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .playlist-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.15rem;
  }

  .eyebrow {
    margin: 0 0 0.35rem;
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .playlist h2 {
    margin: 0;
  }

  .playlist-note {
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .track-list {
    display: grid;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .track {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1.1fr) minmax(10rem, 0.9fr);
    gap: 0.9rem;
    align-items: baseline;
    padding: 0.68rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 70%, transparent);
  }

  .track-number,
  .track-album,
  .track-main span {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .track-number {
    font-variant-numeric: tabular-nums;
  }

  .track-main {
    display: grid;
    gap: 0.18rem;
    min-width: 0;
  }

  .track-main strong {
    font-weight: 620;
  }

  .track-album {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 680px) {
    .work-grid {
      grid-template-columns: 1fr;
    }

    .playlist-header {
      display: block;
    }

    .playlist-note {
      display: block;
      margin-top: 0.4rem;
      white-space: normal;
    }

    .track {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .track-album {
      grid-column: 2;
      white-space: normal;
    }
  }
</style>
